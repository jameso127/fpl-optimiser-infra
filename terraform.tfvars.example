# Copy to terraform.tfvars (gitignored) and fill in.

project_id        = "my-fpl-project"
region            = "europe-west2"
github_repository = "your-github-user/fpl-optimiser-backend"

fpl_team_id       = 123456   # the manager the optimiser advises
telegram_chat_id  = 123456789  # where its recommendations are sent

# Optional
# billing_account_id = "XXXXXX-XXXXXX-XXXXXX"   # creates a 2 GBP/month budget with alerts
